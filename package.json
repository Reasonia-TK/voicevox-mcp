{
  "name": "voicevox-mcp",
  "version": "0.1.0",
  "description": "Windows向けVOICEVOX MCPサーバー。AIアシスタントの要約をずんだもん等の音声で読み上げます。",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "voicevox-mcp": "./dist/index.js"
  },
  "files": [
    "dist/",
    "scripts/play-wav.ps1",
    "templates/",
    "examples/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:check": "node ./scripts/check-version.mjs",
    "start": "node ./dist/index.js",
    "doctor": "node ./dist/index.js doctor",
    "smoke:audio": "npm run build && node ./scripts/smoke-audio.mjs",
    "smoke:live": "npm run build && node ./scripts/smoke-live.mjs",
    "smoke:stop": "npm run build && node ./scripts/smoke-stop.mjs",
    "smoke:stdio": "npm run build && node ./scripts/smoke-stdio.mjs",
    "mcpb:stage": "npm run build && node ./scripts/prepare-mcpb.mjs",
    "mcpb:validate": "npx --yes @anthropic-ai/mcpb@2.1.2 validate ./build/mcpb",
    "mcpb:pack": "npm run mcpb:validate && npx --yes @anthropic-ai/mcpb@2.1.2 pack ./build/mcpb ./build/voicevox-mcp.mcpb",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "voicevox",
    "zundamon",
    "text-to-speech",
    "codex",
    "claude"
  ],
  "license": "MIT",
  "author": {
    "name": "Reasonia-TK",
    "url": "https://github.com/Reasonia-TK"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Reasonia-TK/voicevox-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Reasonia-TK/voicevox-mcp/issues"
  },
  "homepage": "https://github.com/Reasonia-TK/voicevox-mcp#readme",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
